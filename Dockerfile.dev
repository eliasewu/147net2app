# =============================================================================
# Dockerfile.dev — Development image for docker-compose.override.yml
# =============================================================================
# Lightweight Node.js image for hot-reload development. Source code is
# mounted as a volume at runtime, so `node --watch` picks up changes
# instantly. The Vite dev server proxies /api → Express on :3000.
# =============================================================================
FROM node:22-alpine

RUN addgroup -g 1000 nodeapp && adduser -u 1000 -G nodeapp -D nodeapp

WORKDIR /app

# Install dependencies (will be overridden by volume mount at runtime,
# but having them here makes the first `docker compose up` faster)
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps && npm cache clean --force

USER nodeapp

EXPOSE 3000 9229

CMD ["node", "--watch", "server.cjs"]
