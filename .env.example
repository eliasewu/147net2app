# =============================================================================
# NET2APP Hub — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 3000)
PORT=3000

# Node environment: 'development' or 'production'
NODE_ENV=production

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Secret key for signing JSON Web Tokens. MUST be changed in production!
# Used by: server.cjs, external-api.cjs
JWT_SECRET=change-me-to-a-random-64-char-string

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
# Connection details for the main PostgreSQL instance.
# Database `sms_platform` and user `sms_user` are created by schema.sql.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sms_platform
DB_USER=sms_user
DB_PASSWORD=change-me-in-production

# ─── Internal Service Communication ───────────────────────────────────────────
# Shared secret for internal endpoints (X-Internal-Token header).
# Used between the Node.js server and the Java SMPP Gateway.
# If left empty, internal endpoints are unprotected (not recommended in production).
INTERNAL_TOKEN=

# ─── SMPP Gateway (Java) ──────────────────────────────────────────────────────
# URL of the Java 21 SMPP Gateway control plane (smpp-gateway/).
# This is the bridge between Node.js and SMPP supplier interconnects.
JAVA_GATEWAY_URL=http://localhost:8081

# Timeout in milliseconds for Java gateway HTTP calls.
JAVA_GATEWAY_TIMEOUT_MS=3000

# ─── Asterisk Bridge ──────────────────────────────────────────────────────────
# Set to 'true' to enable the Asterisk AMI bridge (asterisk-bridge.cjs).
# When enabled, the bridge connects to Asterisk servers configured in the
# sip_servers / asterisk_settings database tables via the AMI protocol.
# Used by: server.cjs, asterisk-bridge.cjs
ASTERISK_ENABLED=false

# ─── Proxy Registration ───────────────────────────────────────────────────────
# Shared secret for proxy/gateway registration endpoint.
# Used by: server.cjs (/api/proxy/register)
PROXY_REGISTER_SECRET=change-me-in-production

# =============================================================================
# Database-managed settings (no env vars needed — configured via the UI):
# =============================================================================
#
# SMTP / Email    → smtp_config table (emailService.cjs)
# WhatsApp        → social_api_suppliers table (social-pairing.cjs)
# Number Lookup   → number_validation_providers table (number-validation-providers.cjs)
# API Connectors  → api_connectors table (apiExtensions.cjs)
# Voice OTP       → voice_otp_configs table (voiceOtpApi)
# Rates / MCCMNC  → rates + mccmnc tables
# Routing         → route_plans + routes + trunks tables
# =============================================================================
